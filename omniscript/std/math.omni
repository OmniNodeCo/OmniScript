# Extra maths helpers, importable with:  use std/math

fn factorial(n) { if n <= 1 { 1 } else { n * factorial(n - 1) } }

fn combinations(n, k) {
  if k < 0 or k > n { 0 } else { factorial(n) / (factorial(k) * factorial(n - k)) }
}

fn is_prime(n) {
  if n < 2 { return false }
  for i in 2..=sqrt(n) { if n % i == 0 { return false } }
  true
}

fn primes_below(limit) { [2..limit].filter(is_prime) }

fn clamp01(x) { clamp(x, 0, 1) }

fn deg(rad) { degrees(rad) }
fn rad(d) { radians(d) }

fn moving_total(xs, window = 3) {
  xs.map_each((_, i) -> xs.take(i + 1).drop(max(0, i + 1 - window)).sum())
}
