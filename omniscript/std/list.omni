# Extra list helpers, importable with:  use std/list

fn cumulative(xs) {
  mut total = 0
  xs.map((x) -> { total += x; total })
}

fn transpose(matrix) {
  if matrix.len() == 0 { return [] }
  [0..matrix[0].len()].map((i) -> matrix.map((row) -> row[i]))
}

fn moving_average(xs, window = 3) {
  xs.map_each((_, i) -> xs.take(i + 1).drop(max(0, i + 1 - window)).avg())
}

fn pairwise(xs) { [0..xs.len() - 1].map((i) -> [xs[i], xs[i + 1]]) }

fn most_common(xs) {
  xs.counts().sort_by("value", desc: true).first()
}
