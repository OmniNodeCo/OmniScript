# The std/stats module, tested from OmniScript itself.

use std/stats

let xs = [4, 8, 15, 16, 23, 42]

@test
fn spread_and_centre() {
  assert_eq(round_to(stdev(xs), 4), 13.4907)
  assert_eq(percentile(xs, 50), 15.5)
  assert_eq(quartiles(xs).q1, 9.75)
  assert_eq(iqr(xs), 11.5)
}

@test
fn correlation_spots_a_line() {
  assert_eq(correlation([1, 2, 3, 4], [2, 4, 6, 8]), 1)
  assert_eq(correlation([1, 2, 3, 4], [8, 6, 4, 2]), -1)
  assert_true(abs(correlation([1, 2, 3], [3, 1, 2])) < 1)
}

@test
fn summary_covers_the_basics() {
  let s = summary(xs)
  assert_eq(s.count, 6)
  assert_eq(s.min, 4)
  assert_eq(s.max, 42)
  assert_eq(s.sum, 108)
  assert_eq(s.mean, 18)
  assert_true(s.q1 < s.median and s.median < s.q3)
}

@test
fn normalize_scales_to_zero_one() {
  assert_eq(normalize([10, 20, 30]), [0, 0.5, 1])
  assert_eq(normalize([5, 5, 5]), [0, 0, 0])
}
