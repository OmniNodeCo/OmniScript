# OmniScript's own test suite, written in OmniScript.
# Run it with:  ./omni test

@test
fn arithmetic_works() {
  assert_eq(2 + 3 * 4, 14)
  assert_eq((2 + 3) * 4, 20)
  assert_eq(2 ** 10, 1024)
  assert_eq(7 % 3, 1)
}

@test
fn strings_interpolate() {
  let n = 4
  assert_eq("n is \{n}", "n is 4")
  assert_eq("n is ${n * 2}", "n is 8")
  assert_eq("abc".upper(), "ABC")
  assert_eq("a,b,c".split(",").len(), 3)
}

@test
fn lists_behave() {
  let xs = [3, 1, 2]
  assert_eq(xs.sort(), [1, 2, 3])
  assert_eq(xs.map((x) -> x * 10), [30, 10, 20])
  assert_eq(xs.filter((x) -> x > 1).len(), 2)
  assert_eq([1..5], [1, 2, 3, 4])
  assert_eq([1..=3], [1, 2, 3])
}

@test
fn maps_and_null_safety() {
  let m = {a: {b: 1}}
  assert_eq(m.a.b, 1)
  assert_eq(m?.a?.b, 1)
  assert_eq(m?.x?.y, null)
  assert_eq(m?.x?.y ?? 9, 9)
}

@test
fn functions_and_closures() {
  fn make_counter() {
    mut n = 0
    fn bump() { n += 1; n }
    bump
  }
  let c = make_counter()
  c()
  c()
  assert_eq(c(), 3)
}

@test
fn pattern_matching() {
  let shape = match [1, 2] {
    [a, b] => a + b
    _ => 0
  }
  assert_eq(shape, 3)
  let kind = match 42 {
    x when x > 100 => "big"
    x is num => "number"
    _ => "other"
  }
  assert_eq(kind, "number")
}

@test
fn classes_and_inheritance() {
  class Base {
    fn name() { "base" }
  }
  class Child : Base {
    fn extra() { "extra" }
  }
  let c = new Child()
  assert_eq(c.name(), "base")
  assert_eq(c.extra(), "extra")
  assert_true(c is Base)
}

@test
fn errors_are_catchable() {
  let caught = try { error("nope") } catch e { e.message }
  assert_eq(caught, "nope")
  assert_throws(() -> 1 / 0)
}

@test
fn higher_order_and_pipes() {
  let out = [3, 1, 2] |> sorted |> map_each((x) -> x * 2) |> join("-")
  assert_eq(out, "2-4-6")
  assert_eq([1, 2, 3].reduce((a, b) -> a + b, 10), 16)
}

@test
fn json_round_trip() {
  let data = {name: "omni", tags: ["a", "b"], on: true}
  let text = to_json(data)
  let back = json(text)
  assert_eq(back.name, "omni")
  assert_eq(back.tags[1], "b")
  assert_eq(back.on, true)
}

@test
fn csv_parses() {
  let rows = read_csv(text: "a,b\n1,2\n3,4\n")
  assert_eq(rows.len(), 2)
  assert_eq(rows[1].b, 4)
}

@test
fn shell_integration() {
  assert_eq(cmd("echo ping").trim(), "ping")
  assert_true(cmd("true").ok)
  assert_true(not cmd("false").ok)
}
