# The awkward corners of the language, each one a real bug that once existed.
# Run with:  ./omni test

@test
fn optional_chaining_short_circuits_calls() {
  let cfg = {db: {pool: 4}}
  assert_eq(cfg?.db?.pool, 4)
  assert_eq(cfg?.nope?.deep ?? "fallback", "fallback")
  assert_eq(cfg?.refresh(), null)
}

@test
fn slices_may_be_open_at_either_end() {
  let xs = [10, 20, 30, 40]
  assert_eq(xs[..2], [10, 20])
  assert_eq(xs[..=2], [10, 20, 30])
  assert_eq(xs[2..], [30, 40])
  assert_eq(xs[::-1], [40, 30, 20, 10])
  assert_eq("hello"[..2], "he")
}

@test
fn range_bounds_do_arithmetic_first() {
  let xs = [1, 2, 3, 4]
  assert_eq([0..xs.len() - 1], [0, 1, 2])
  assert_eq([2 * 2..8], [4, 5, 6, 7])
  assert_eq(2 + 3 * 4, 14)
}

@test
fn flatten_takes_a_depth() {
  assert_eq([1, [2, [3, [4]]]].flatten(), [1, 2, [3, [4]]])
  assert_eq([1, [2, [3, [4]]]].flatten(depth: -1), [1, 2, 3, 4])
  assert_eq(flatten([1, [2, [3]]], depth: 2), [1, 2, 3])
}

@test
fn regex_replacements_name_their_groups() {
  assert_eq(regex_replace("2026-09-15", r"(\d+)-(\d+)-(\d+)", "$3/$2/$1"), "15/09/2026")
  assert_eq(regex_replace("2026-09-15", r"(\d+)-(\d+)-(\d+)", "\\1"), "2026")
  assert_eq(regex_replace("2026-09-15", r"(\d+)-(\d+)-(\d+)", "\\3"), "15")
  assert_eq(regex_replace("ada lovelace", r"(?P<f>\w+) (?P<l>\w+)", "\${l}, \${f}"),
            "lovelace, ada")
  assert_eq(regex_replace("a b c", r" ", "_", count: 1), "a_b c")
  assert_eq(regex_all("a1 b22", r"([a-z])(\d+)", groups: true), [["a", "1"], ["b", "22"]])
}

@test
fn strings_escape_a_literal_dollar() {
  let x = 1
  assert_eq("${x}", "1")
  assert_eq("\${x}", "$" + "{x}")      # the escape keeps it literal
  assert_eq("""
two
lines""", "\ntwo\nlines")
  assert_eq(r"\d+", "\\d+")
}

@test
fn new_chains_into_methods() {
  class Point {
    x = 0
    y = 0
    new(x, y) { self.x = x; self.y = y }
    fn sum() { self.x + self.y }
  }
  assert_eq(new Point(2, 3).sum(), 5)
}

@test
fn super_reaches_the_parent_method() {
  class A { fn name() { "a" } }
  class B : A { fn name() { super.name() + "b" } }
  assert_eq(new B().name(), "ab")
}

@test
fn classes_can_implement_language_hooks() {
  class Bag {
    items = []
    new(*xs) { self.items = list(xs) }
    fn len() { self.items.len() }
    fn iter() { self.items }
    fn eq(other) { self.items == other.items }
    fn str() { "Bag(${self.items.len()})" }
  }
  let b = new Bag(1, 2, 3)
  mut total = 0
  for x in b { total += x }
  assert_eq(str(b), "Bag(3)")
  assert_eq(len(b), 3)
  assert_true(b == new Bag(1, 2, 3))
  assert_eq(total, 6)
}

@test
fn loops_capture_a_fresh_binding() {
  let fns = []
  for i in 1..=3 { fns.push(() -> i) }
  assert_eq(fns.map((f) -> f()), [1, 2, 3])
}

@test
fn try_works_inside_expressions() {
  let safe = (a, b) -> try { a / b } catch e { "err" }
  assert_eq([1, 0, 2].map((x) -> safe(10, x)), [10, "err", 5])
}

@test
fn sort_accepts_keys_and_comparators() {
  let people = [{n: "bb", a: 2}, {n: "a", a: 3}, {n: "ccc", a: 1}]
  assert_eq(people.sort("a").map((p) -> p.n), ["ccc", "bb", "a"])
  assert_eq(people.sort((p) -> len(p.n)).map((p) -> p.n), ["a", "bb", "ccc"])
  assert_eq([3, 1, 2].sort((a, b) -> b - a), [3, 2, 1])
}

@test
fn whole_number_division() {
  assert_eq(7 // 2, 3)
  assert_eq(-7 // 2, -4)
  assert_eq(7 / 2, 3.5)
  assert_eq(1 + 8 // 2 * 3, 13)
}

@test
fn comparisons_chain() {
  let x = 5
  assert_true(1 < x < 10)
  assert_true(0 <= x <= 5)
  assert_true(not (1 < x < 3))
  assert_true("a" < "b" < "c")
}

@test
fn several_targets_assign_at_once() {
  mut a = 1
  mut b = 2
  a, b = b, a
  assert_eq([a, b], [2, 1])
  let xs = [1, 2]
  let ys = [3, 4]
  xs[0], ys[1] = 9, 8
  assert_eq(xs, [9, 2])
  assert_eq(ys, [3, 8])
}

@test
fn parameters_can_be_patterns() {
  fn dist([x1, y1], [x2, y2]) { ((x2 - x1) ** 2 + (y2 - y1) ** 2) ** 0.5 }
  assert_eq(dist([0, 0], [3, 4]), 5)
  fn show({name, age}) { "${name} is ${age}" }
  assert_eq(show({name: "ada", age: 36}), "ada is 36")
  assert_eq([[1, 2], [3, 4]].map(([a, b]) -> a * b), [2, 12])
  assert_eq([{n: 1}, {n: 2}].map(({n}) -> n * 10), [10, 20])
  fn total([a, b] = [10, 20]) { a + b }
  assert_eq([total(), total([1, 1])], [30, 2])
  let g = fn (x) { x * 2 }
  assert_eq(g(4), 8)
}
