#!/usr/bin/env python3
"""OmniScript launcher.

    ./omni run hello.omni
    ./omni hello.omni              (same thing)
    ./omni repl
    ./omni -e 'print("hi")'
    ./omni test
    ./omni docs
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(os.path.realpath(__file__))))

from omniscript.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
