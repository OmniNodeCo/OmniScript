{
  "scopeName": "source.omni",
  "name": "OmniScript",
  "fileTypes": ["omni"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#attributes" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#calls" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.number-sign.omni", "match": "#[^{].*$|^#$" },
        {
          "name": "comment.block.omni",
          "begin": "#\\{",
          "end": "\\}#"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.omni",
          "begin": "\"\"\"|'''",
          "end": "\"\"\"|'''",
          "patterns": [{ "include": "#interpolation" }]
        },
        {
          "name": "string.quoted.raw.omni",
          "begin": "r\"",
          "end": "\""
        },
        {
          "name": "string.quoted.double.omni",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#interpolation" },
            {
              "name": "constant.character.escape.omni",
              "match": "\\\\(n|t|r|\\\\|'|\"|0|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
            }
          ]
        },
        {
          "name": "string.quoted.single.omni",
          "begin": "'",
          "end": "'",
          "patterns": [{ "include": "#interpolation" }]
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "meta.embedded.line.omni",
          "begin": "\\$\\{|\\\\\\{",
          "end": "\\}",
          "contentName": "source.omni",
          "patterns": [{ "include": "source.omni" }]
        }
      ]
    },
    "attributes": {
      "patterns": [
        { "name": "storage.modifier.attribute.omni", "match": "@[a-zA-Z_][a-zA-Z0-9_]*" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.omni",
          "match": "\\b(if|else|for|while|do|match|when|break|continue|return|try|catch|finally|throw|use|from|as|by|in)\\b"
        },
        {
          "name": "keyword.declaration.omni",
          "match": "\\b(let|mut|fn|class|new)\\b"
        },
        {
          "name": "keyword.operator.logical.omni",
          "match": "\\b(and|or|not|is|isnt)\\b"
        },
        {
          "name": "constant.language.omni",
          "match": "\\b(true|false|null|self|super)\\b"
        },
        {
          "name": "support.variable.omni",
          "match": "\\b(pi|e|tau|args)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.omni", "match": "\\b0[xX][0-9a-fA-F_]+\\b" },
        { "name": "constant.numeric.binary.omni", "match": "\\b0[bB][01_]+\\b" },
        { "name": "constant.numeric.octal.omni", "match": "\\b0[oO][0-7_]+\\b" },
        {
          "name": "constant.numeric.omni",
          "match": "\\b[0-9][0-9_]*(\\.[0-9_]+)?([eE][-+]?[0-9]+)?\\b|\\.[0-9][0-9_]*([eE][-+]?[0-9]+)?"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.omni",
          "match": "\\|>|\\|\\|>"
        },
        {
          "name": "keyword.operator.omni",
          "match": "\\*\\*|\\.\\.=|\\.\\.|\\?\\?|\\?:|\\?\\.|==|!=|<=|>=|\\+=|-=|\\*=|/=|%=|\\^=|\\|\\||&&|->|::"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.omni" },
            "2": { "name": "entity.name.function.omni" }
          }
        },
        {
          "match": "\\b(class)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.omni" },
            "2": { "name": "entity.name.type.class.omni" }
          }
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": { "1": { "name": "entity.name.function.call.omni" } }
        }
      ]
    }
  }
}
