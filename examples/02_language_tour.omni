# A guided tour of the language, one idea per section.

print("--- values -------------------------------------------------")
let n = 42
let pi_approx = 3.14159
let greeting = "omni"
let flags = {fast: true, safe: true, boring: false}
let matrix = [[1, 2], [3, 4]]
print(type(n), type(greeting), type(flags), type(matrix))
print(flags.fast, matrix[1][0], greeting[0..2])

print("--- functions ----------------------------------------------")
fn greet(who, punctuation = "!") {
  "hello ${who}${punctuation}"
}
fn fibonacci(count) {
  mut a = 0
  mut b = 1
  mut out = []
  for _ in 0..count {
    out.push(a)
    let next = a + b
    a = b
    b = next
  }
  out
}
print(greet("ada"), greet("grace", punctuation: "?"))
print(fibonacci(10))

print("--- lambdas and higher order -------------------------------")
let numbers = [5, 3, 9, 1, 7]
print(numbers.map((x) -> x * 2))
print(numbers.filter((x) -> x > 4))
print(numbers.reduce((total, x) -> total + x, 0))
print(numbers.sort())

print("--- control flow -------------------------------------------")
mut countdown = 3
while countdown > 0 {
  print("t minus", countdown)
  countdown -= 1
}

let verdict = match 42 {
  0 => "zero"
  x when x < 10 => "small ${x}"
  x when x < 100 => "medium ${x}"
  _ => "huge"
}
print(verdict)

print("--- destructuring ------------------------------------------")
let [first, second, *rest] = [1, 2, 3, 4, 5]
print(first, second, rest)
let {name, age} = {name: "ada", age: 36, city: "london"}
print(name, age)

print("--- null safety --------------------------------------------")
let config = {db: {host: "localhost"}}
print(config?.db?.host)
print(config?.cache?.host ?? "no cache configured")

print("--- errors -------------------------------------------------")
try {
  let risky = 1 / 0
} catch e {
  print("caught:", e.message)
}
