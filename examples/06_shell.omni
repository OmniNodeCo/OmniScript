# Talk to the operating system in single calls.

let who = cmd("whoami").trim()
print("running as", who)

let files = cmd("ls -1").lines()
print("files here:", files.len())

# Non-zero exits are data, not crashes.
let missing = cmd("this-command-does-not-exist-xyz")
print("exit code:", missing.code, "ok?", missing.ok)

# Chain shell output through OmniScript.
let longest = cmd("printf 'a\\nbbb\\ncc\\n'").lines() |> sorted((a, b) -> len(b) - len(a)) |> first()
print("longest line:", longest)

# Files and paths.
write(".preview/note.txt", "written by OmniScript\n")
print(read(".preview/note.txt").trim())
print("extension:", path_ext(".preview/note.txt"))
remove(".preview/note.txt")
print("gone?", not exists(".preview/note.txt"))
