# Modules: one file, one module. `use` pulls in its definitions.

use std/math            # factorial, is_prime, combinations, primes_below, ...
use std/text            # initials, truncate, pluralize, box
use {cumulative, moving_average} from std/list
use std/list as L

print(factorial(10))
print(primes_below(30))
print(initials("grace brewster hopper"))
print(box("modules", 24))
print(cumulative([1, 2, 3, 4]))
print(moving_average([1, 2, 3, 4, 5], 3))
print(L.transpose([[1, 2, 3], [4, 5, 6]]))
