# Read CSV, clean it, group it, answer questions, write reports.
# Whole pipeline: no imports, no boilerplate.

let csv = """region,product,units,price
north,widget,120,9.5
south,widget,80,9.5
north,gadget,40,24
east,gadget,65,24
south,gizmo,200,3.25
east,widget,30,9.5
north,gizmo,150,3.25"""

write(".preview/sales.csv", csv)
let rows = read_csv(".preview/sales.csv")
print("loaded", rows.len(), "rows")

# Add a computed column with one map.
let enriched = rows.map((row) -> merge(row, {revenue: row.units * row.price}))

# Questions, each one line.
print("total revenue:", round_to(enriched.sum((r) -> r.revenue), 2))

let by_region = enriched.group_by("region")
for region, items in by_region {
  print("  ${region}: ${round_to(items.sum((r) -> r.revenue), 2)}")
}

let best = enriched.sort((r) -> r.revenue, desc: true).first()
print("best seller:", best.product, "in", best.region)

let big = enriched.filter((r) -> r.units >= 100)
print("lines with 100+ units:", big.len())

# Reports in two formats.
write_csv(".preview/report.csv", enriched)
write_json(".preview/report.json", by_region)
table(enriched.sort((r) -> r.revenue, desc: true), title: "sales")

print("wrote report.csv and report.json")
