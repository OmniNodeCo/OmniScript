# Dates, arithmetic on them, and a small report.

use std/stats

let releases = [
  {version: "1.0", on: "2026-01-15", effort: 120},
  {version: "1.1", on: "2026-03-02", effort: 40},
  {version: "1.2", on: "2026-06-30", effort: 95},
  {version: "2.0", on: "2026-11-18", effort: 310},
]

let today = date()
print("today is ${today.format("%A, %d %B %Y")}")

# Parse, compare and shift dates with ordinary operators.
let plan = releases.map((r) -> {
  version: r.version,
  date: date(r.on),
  days_out: round_to(date(r.on).diff(today, "days")),
  quarter: "Q${int((date(r.on).month - 1) / 3) + 1}",
  effort: r.effort,
})

for r in plan.sort("date") {
  let timing = r.days_out >= 0 ? "in ${r.days_out} days" : "${-r.days_out} days ago"
  print("  ${r.version}  ${r.date.iso}  ${r.quarter}  (${timing})")
}

# A week later, a month later, and the span between two releases.
let first = date("2026-01-15")
print("a week after 1.0:", first + weeks(1))
print("a month after 1.0:", first.add(months: 1).format("%d %B %Y"))
print("days between 1.0 and 2.0:", date("2026-11-18").diff(first, "days"))

# Statistics over the effort column.
let efforts = plan.map((r) -> r.effort)
print("effort:", summary(efforts))

# Which releases fall on a weekend?
for day in date_range("2026-09-14", "2026-09-20") {
  print("  ${day.iso} ${day.weekday}${day.weekend ? "  <- weekend" : ""}")
}

table(plan.map((r) -> {version: r.version, date: r.date.iso, quarter: r.quarter,
                       effort: r.effort}), title: "release plan")
