# Classes, inheritance and error handling.

class Shape {
  name = "shape"
  fn area() { 0 }
  fn describe() { "${self.name}: area ${round_to(self.area(), 2)}" }
}

class Circle : Shape {
  radius = 1
  new(radius) { self.radius = radius; self.name = "circle" }
  fn area() { pi * self.radius ** 2 }
}

class Rect : Shape {
  w = 1
  h = 1
  new(w, h) { self.w = w; self.h = h; self.name = "rect" }
  fn area() { self.w * self.h }
}

let shapes = [new Circle(2), new Rect(3, 4), new Circle(0.5)]
for s in shapes {
  print(s.describe())
}
print("total area:", round_to(shapes.sum((s) -> s.area()), 2))

# Errors are values you can catch and inspect.
class ValidationError : Error {
  new(field, message) {
    self.field = field
    self.message = message
  }
}

fn validate_age(value) {
  if value < 0 or value > 150 {
    throw new ValidationError("age", "${value} is not a plausible age")
  }
  value
}

for candidate in [29, -3, 200] {
  try {
    print("ok:", validate_age(candidate))
  } catch e {
    print("rejected:", e.message)
  }
}
