# Draw pictures with a built-in software rasteriser. No dependencies.

let c = draw(window_size(480, 320), bg: "#0f172a")

c.gradient(0, 0, c.w, c.h, "#0f172a", "#1e293b")
c.text(16, 16, "OmniScript canvas", "#e2e8f0", 2)
c.line(16, 40, 464, 40, "#334155", 1)

# A ring of circles in the built-in palette.
for i in 0..12 {
  let angle = i / 12 * 2 * pi
  let x = 140 + cos(angle) * 70
  let y = 180 + sin(angle) * 70
  c.circle(x, y, 18, palette(i), filled: true)
}

# Shapes and labels.
c.rounded_rect(280, 120, 160, 120, 14, "#1d4ed8")
c.text(300, 170, "rounded", "#ffffff", 2)
c.poly([[300, 280], [340, 240], [380, 280]], "#f59e0b")
c.triangle(400, 280, 430, 240, 460, 280, "#22c55e")

c.save(".preview/canvas.png")

# Charts come free.
chart([4, 8, 15, 16, 23, 42], kind: "bar", title: "the numbers",
      labels: ["a", "b", "c", "d", "e", "f"]).save(".preview/bars.png")
chart([1, 3, 2, 5, 4, 7, 6], kind: "line", title: "a trend").save(".preview/trend.png")
chart({pie: 3, chart: 1, demo: 2}, kind: "pie", title: "shares").save(".preview/pie.png")
progress_bar(0.72, width: 320, label: "loading").save(".preview/progress.png")
